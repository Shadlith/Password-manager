<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".GeneratePasswordActivity">

    <EditText
        android:id="@+id/generatePasswordActivityGeneratePasswordEditText"
        android:layout_width="237dp"
        android:layout_height="55dp"
        android:layout_marginStart="88dp"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="88dp"
        android:ems="10"
        android:hint="Generated Password"
        android:inputType="text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <SeekBar
        android:id="@+id/generatePasswordActivitySeekBar"
        android:layout_width="177dp"
        android:layout_height="50dp"
        android:layout_marginStart="117dp"
        android:layout_marginTop="72dp"
        android:layout_marginEnd="117dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/generatePasswordActivityPasswordCriteraContainer" />

    <LinearLayout
        android:id="@+id/generatePasswordActivityPasswordCriteraContainer"
        android:layout_width="376dp"
        android:layout_height="191dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/generatePasswordActivityGeneratePasswordEditText">

        <!-- Criterion: At least 8 characters -->

        <!-- Criterion: At least one uppercase letter -->
        <LinearLayout
            android:id="@+id/generatePasswordActivityCriteriaLength"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/iconLength"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_cross" />  <!-- Default icon: unmet -->

            <TextView
                android:id="@+id/tvLength"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="At least 8 characters" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/generatePasswordActivityCriteriaUpperCase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/iconUpperCase"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_cross" />

            <TextView
                android:id="@+id/tvUpperCase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="At least one uppercase letter" />
        </LinearLayout>

        <!-- Criterion: At least one lowercase letter -->
        <LinearLayout
            android:id="@+id/generatePasswordActivityCriteriaLowerCase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/iconLowerCase"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_cross" />

            <TextView
                android:id="@+id/tvLowerCase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="At least one lowercase letter" />
        </LinearLayout>

        <!-- Criterion: At least one number -->
        <LinearLayout
            android:id="@+id/generatePasswordActivityCriteriaNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/iconNumber"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_cross" />

            <TextView
                android:id="@+id/tvNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="At least one number" />
        </LinearLayout>

        <!-- Criterion: At least one symbol -->
        <LinearLayout
            android:id="@+id/generatePasswordActivityCriteriaSymbol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/iconSymbol"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_cross" />

            <TextView
                android:id="@+id/tvSymbol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="At least one symbol" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/generatePasswordActivityGeneratePasswordButton"
        android:layout_width="148dp"
        android:layout_height="52dp"
        android:layout_marginStart="132dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="131dp"
        android:text="Generate"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/generatePasswordActivitySeekBar" />

    <Button
        android:id="@+id/generatePasswordActivityAcceptGeneratedPasswordButton"
        android:layout_width="147dp"
        android:layout_height="73dp"
        android:layout_marginStart="132dp"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="132dp"
        android:text="Accept"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/generatePasswordActivityGeneratePasswordButton" />

    <TextView
        android:id="@+id/generatePasswordActivityCriteraLengthTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="106dp"
        android:layout_marginEnd="106dp"
        android:text="Number Of Characters Required"
        app:layout_constraintBottom_toTopOf="@+id/generatePasswordActivitySeekBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/generatePasswordActivityPasswordCriteraContainer"
        app:layout_constraintVertical_bias="0.87" />

    <Button
        android:id="@+id/generatePasswordActivityLogoutButton"
        android:layout_width="95dp"
        android:layout_height="43dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:text="Logout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/generatePasswordActivityBackButton"
        android:layout_width="90dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="Back"
        app:layout_constraintEnd_toStartOf="@+id/generatePasswordActivityLogoutButton"
        app:layout_constraintHorizontal_bias="0.012"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>