<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".GeneratePasswordActivity">

    <EditText
        android:id="@+id/generatePasswordActivityGeneratePasswordEditText"
        android:layout_width="237dp"
        android:layout_height="55dp"
        android:layout_marginStart="88dp"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="88dp"
        android:ems="10"
        android:hint="Generated Password"
        android:inputType="text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/generatePasswordActivityPasswordCriteraContainer"
        android:layout_width="376dp"
        android:layout_height="175dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/generatePasswordActivityGeneratePasswordEditText">

        <CheckBox
            android:id="@+id/checkBoxUpperCaseRequirement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upper Case Letter required?" />

        <CheckBox
            android:id="@+id/checkBoxNumberCaseRequirement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Number Required?" />

        <CheckBox
            android:id="@+id/checkBoxSpecialCharacterRequirement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Special Character required?" />
    </LinearLayout>

    <Button
        android:id="@+id/generatePasswordActivityGeneratePasswordButton"
        android:layout_width="147dp"
        android:layout_height="52dp"
        android:layout_marginStart="132dp"
        android:layout_marginTop="44dp"
        android:text="Generate"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/CharRequirementReadout" />

    <Button
        android:id="@+id/generatePasswordActivityAcceptGeneratedPasswordButton"
        android:layout_width="147dp"
        android:layout_height="73dp"
        android:layout_marginStart="132dp"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="132dp"
        android:text="Accept"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/generatePasswordActivityGeneratePasswordButton" />

    <TextView
        android:id="@+id/generatePasswordActivityCriteraLengthTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="106dp"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="106dp"
        android:text="Number Of Characters Required"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/generatePasswordActivityPasswordCriteraContainer" />

    <Button
        android:id="@+id/generatePasswordActivityLogoutButton"
        android:layout_width="95dp"
        android:layout_height="43dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:text="Logout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/generatePasswordActivityBackButton"
        android:layout_width="90dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="Back"
        app:layout_constraintEnd_toStartOf="@+id/generatePasswordActivityLogoutButton"
        app:layout_constraintHorizontal_bias="0.012"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/CharRequirementReadout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:ems="10"
        android:inputType="number"
        android:text="8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.472"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/generatePasswordActivityCriteraLengthTextView" />
</androidx.constraintlayout.widget.ConstraintLayout>